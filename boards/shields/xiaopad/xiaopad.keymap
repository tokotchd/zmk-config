#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zmk-input-inertia/input/processor/input_inertia.dtsi>

/ {
    tps43_input: tps43_input {
        compatible = "zmk,input-listener";
        device = <&tps43>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT)
//            &zip_inertia
        >;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &trans
            >;
        };
    };
};

&zip_inertia {
    trigger-ms = <35>;              // Wait time after lift-off before coasting starts
    move-decay-factor-int = <90>;   // 0-99% velocity retained per tick (higher = less friction)
    move-threshold-start = <15>;    // Minimum flick speed required to trigger coasting
    move-threshold-stop = <1>;      // Speed at which cursor comes to a full stop
};